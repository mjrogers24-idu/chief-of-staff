# Copy this file to .env.local and fill in values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
# This is a NEW Firebase project, separate from Family Command Center's.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web push certificate — Firebase console > Project settings > Cloud
# Messaging > Web Push certificates > Generate key pair. Push notifications
# (src/lib/push.ts) stay disabled without this.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-side only (never exposed to the browser).

# Service account JSON for the SAME Firebase project above, as a single
# line of JSON. Firebase console > Project settings > Service accounts >
# Generate new private key. Used by API routes to read/write Firestore
# with admin privileges (e.g. storing Google OAuth refresh tokens, which
# firestore.rules blocks the client from ever touching).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Cloud OAuth client (APIs & Services > Credentials > OAuth client
# ID > Web application) with the Calendar API enabled and an authorized
# redirect URI of "<GOOGLE_OAUTH_REDIRECT_BASE_URL>/api/google/callback".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Base URL of this app as Google will redirect back to it, e.g.
# http://localhost:3000 in dev, or the deployed URL in production.
GOOGLE_OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Random string used to sign the OAuth `state` param so the callback route
# only trusts state this server issued. Generate with e.g.
# `openssl rand -hex 32`.
OAUTH_STATE_SECRET=
