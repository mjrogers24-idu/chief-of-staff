# Copy to .env (gitignored). Firebase Functions v2 loads this automatically
# for both `firebase emulators:start` and `firebase deploy`.
#
# Same OAuth client as the Next app's GOOGLE_OAUTH_CLIENT_ID/SECRET
# (../.env.local.example) — reused here because the ingestion job needs to
# exchange each parent's stored refresh token for an access token to call
# the Calendar API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Gemini API key (Google AI Studio > Get API key) for the nutritionist
# agent (generateMealPlan).
GEMINI_API_KEY=
