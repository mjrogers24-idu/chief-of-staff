rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app (Michelle). Anyone signed in via Firebase Auth is
    // treated as the app's one user — no per-user data partitioning needed.
    match /briefRules/{ruleId} {
      allow read, write: if request.auth != null;
    }
    match /recurringSchedule/{itemId} {
      allow read, write: if request.auth != null;
    }
    // Holds Google OAuth refresh tokens. Only the server (Admin SDK, which
    // bypasses these rules) may read/write this — never the client.
    match /googleAccounts/{parent} {
      allow read, write: if false;
    }
    // Written only by the dailyIngestion Cloud Function (Admin SDK,
    // bypasses these rules); the dashboard reads it.
    match /dailyBriefs/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Written by the generateMealPlan callable Cloud Function (Admin SDK,
    // bypasses these rules) — and also directly by Michelle from
    // /admin/meals for manual add/edit/delete of individual dinners, same
    // client-managed pattern as briefRules/recurringSchedule.
    match /mealPlans/{weekStart} {
      allow read, write: if request.auth != null;
    }
    // Initially written by the parseCalendarUpload callable (Admin SDK)
    // as unconfirmed events; Michelle edits/confirms/deletes them
    // directly from /admin/daycare, same as briefRules/recurringSchedule.
    match /uploadedEvents/{eventId} {
      allow read, write: if request.auth != null;
    }
    // The forms/paperwork tracker (spec 3.4) — fully client-managed.
    match /openTasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    // Gemini-suggested "this email might need a follow-up" from the daily
    // gmail.readonly inbox scan (scanInboxFollowUps, Admin SDK — bypasses
    // these rules for the create). Never auto-becomes a real task; a
    // suggestion is deleted once Michelle reviews it from /admin/tasks
    // (confirmed → a new openTasks doc, or dismissed).
    match /emailFollowUps/{suggestionId} {
      allow read, delete: if request.auth != null;
      allow create, update: if false;
    }
  }
}
