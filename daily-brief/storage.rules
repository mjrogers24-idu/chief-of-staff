rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded daycare-calendar images/PDFs (spec 3.0.1). Only the
    // signed-in user may upload/read; parsing happens server-side via the
    // Admin SDK (parseCalendarUpload), which bypasses these rules.
    match /daycare-calendars/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
